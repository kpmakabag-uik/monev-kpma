generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_fkey")
}

model cycle {
  id             String  @id
  tahun_akademik String
  semester       String
  isActive       Boolean @default(false)

  @@unique([tahun_akademik, semester], map: "Cycle_tahun_akademik_semester_key")
}

model document {
  id          String   @id
  type        String
  title       String
  description String?  @db.Text
  fileUrl     String?  @db.Text
  createdAt   DateTime @default(now())
}

model faculty {
  id    String  @id
  name  String
  prodi prodi[]
  user  user[]
}

model instrument {
  id                 String        @id
  category           String
  name               String
  kriteria           String
  indikator          String
  jenjang_peruntukan String
  questions          String        @db.Text
  monevrecord        monevrecord[]
}

model level {
  id   String @id
  name String @unique(map: "Level_name_key")
}

model monevrecord {
  id                 String     @id
  prodiId            String
  instrumentId       String
  tahun_akademik     String
  semester           String
  analisa_kpma       String?    @db.Text
  tindak_lanjut_kpma String?    @db.Text
  answers            String     @db.Text
  updatedAt          DateTime   @default(now())
  instrument         instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, map: "MonevRecord_instrumentId_fkey")
  prodi              prodi      @relation(fields: [prodiId], references: [id], onDelete: NoAction, map: "MonevRecord_prodiId_fkey")

  @@unique([prodiId, instrumentId, tahun_akademik, semester], map: "MonevRecord_prodiId_instrumentId_tahun_akademik_semester_key")
  @@index([instrumentId], map: "MonevRecord_instrumentId_fkey")
}

model prodi {
  id          String        @id
  facultyId   String
  name        String
  jenjang     String
  monevrecord monevrecord[]
  faculty     faculty       @relation(fields: [facultyId], references: [id], onDelete: NoAction, map: "Prodi_facultyId_fkey")
  user        user[]

  @@index([facultyId], map: "Prodi_facultyId_fkey")
}

model session {
  id           String   @id
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_fkey")
}

model setting {
  id            String  @id
  appscript_url String?
  storage_type  String  @db.VarChar(512)
}

model user {
  id            String    @id
  name          String?
  username      String?   @unique(map: "User_username_key")
  password      String?
  email         String?   @unique(map: "User_email_key")
  emailVerified DateTime?
  image         String?
  role          String?   @default("GKM")
  facultyId     String?
  prodiId       String?
  account       account[]
  session       session[]
  faculty       faculty?  @relation(fields: [facultyId], references: [id], map: "User_facultyId_fkey")
  prodi         prodi?    @relation(fields: [prodiId], references: [id], map: "User_prodiId_fkey")

  @@index([facultyId], map: "User_facultyId_fkey")
  @@index([prodiId], map: "User_prodiId_fkey")
}

model verificationtoken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token], map: "VerificationToken_identifier_token_key")
}
