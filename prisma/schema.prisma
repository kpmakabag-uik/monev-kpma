generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_fkey")
  @@map("Account")
}

model cycle {
  id             String    @id @default(cuid())
  tahun_akademik String
  semester       String
  isActive       Boolean   @default(false)
  startDate      DateTime?
  endDate        DateTime?

  @@unique([tahun_akademik, semester], map: "Cycle_tahun_akademik_semester_key")
  @@map("Cycle")
}

model document {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?  @db.Text
  fileUrl     String?  @db.Text
  createdAt   DateTime @default(now())

  @@map("Document")
}

model faculty {
  id    String  @id @default(cuid())
  name  String
  prodi prodi[]
  user  user[]

  @@map("Faculty")
}

model instrument {
  id                 String        @id @default(cuid())
  category           String
  name               String
  kriteria           String
  indikator          String
  jenjang_peruntukan String
  questions          String        @db.Text
  monevrecord        monevrecord[]

  @@map("Instrument")
}

model level {
  id   String @id @default(cuid())
  name String @unique(map: "Level_name_key")

  @@map("Level")
}

model monevrecord {
  id                  String     @id @default(cuid())
  prodiId             String
  instrumentId        String
  tahun_akademik      String
  semester            String
  analisa_kpma        String?    @db.Text
  tindak_lanjut_kpma  String?    @db.Text
  answers             String     @db.Text
  updatedAt           DateTime   @default(now())
  isAnalysisPublished Boolean    @default(false)
  analysisPublishedAt DateTime?
  instrument          instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, map: "MonevRecord_instrumentId_fkey")
  prodi               prodi      @relation(fields: [prodiId], references: [id], onDelete: NoAction, map: "MonevRecord_prodiId_fkey")

  @@unique([prodiId, instrumentId, tahun_akademik, semester], map: "MonevRecord_prodiId_instrumentId_tahun_akademik_semester_key")
  @@index([instrumentId], map: "MonevRecord_instrumentId_fkey")
  @@map("MonevRecord")
}

model monevsubmission {
  id             String    @id @default(cuid())
  prodiId        String
  tahun_akademik String
  semester       String
  isSubmitted    Boolean   @default(false)
  submittedAt    DateTime?
  agreedToPact   Boolean   @default(false)
  pactAgreedAt   DateTime?
  pactAgreedBy   String?
  prodi          prodi     @relation(fields: [prodiId], references: [id], onDelete: Cascade, map: "MonevSubmission_prodiId_fkey")

  @@unique([prodiId, tahun_akademik, semester], map: "MonevSubmission_prodi_cycle_key")
  @@index([prodiId], map: "MonevSubmission_prodiId_fkey")
  @@map("MonevSubmission")
}

model prodi {
  id              String            @id @default(cuid())
  facultyId       String
  name            String
  jenjang         String
  monevrecord     monevrecord[]
  monevsubmission monevsubmission[]
  faculty         faculty           @relation(fields: [facultyId], references: [id], onDelete: NoAction, map: "Prodi_facultyId_fkey")
  user            user[]
  monevevidence   monevevidence[]

  @@index([facultyId], map: "Prodi_facultyId_fkey")
  @@map("Prodi")
}

model monevevidence {
  id             String   @id @default(cuid())
  prodiId        String
  instrumentId   String
  category       String?
  questionId     String
  questionNo     String?
  questionText   String?  @db.Text
  evaluasiDiri   String?  @db.Text
  tahun_akademik String
  semester       String
  url            String   @db.VarChar(1024)
  fileName       String   @db.VarChar(512)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  prodi          prodi    @relation(fields: [prodiId], references: [id], onDelete: Cascade)

  @@index([prodiId])
  @@index([instrumentId])
  @@index([category])
  @@index([fileName])
  @@index([tahun_akademik, semester])
  @@map("MonevEvidence")
}

model session {
  id           String   @id @default(cuid())
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_fkey")
  @@map("Session")
}

model setting {
  id            String  @id @default(cuid())
  appscript_url String?
  storage_type  String  @db.VarChar(512)

  @@map("Setting")
}

model user {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique(map: "User_username_key")
  password      String?
  email         String?   @unique(map: "User_email_key")
  emailVerified DateTime?
  image         String?
  role          String?   @default("GKM")
  facultyId     String?
  prodiId       String?
  account       account[]
  session       session[]
  faculty       faculty?  @relation(fields: [facultyId], references: [id], map: "User_facultyId_fkey")
  prodi         prodi?    @relation(fields: [prodiId], references: [id], map: "User_prodiId_fkey")

  @@index([facultyId], map: "User_facultyId_fkey")
  @@index([prodiId], map: "User_prodiId_fkey")
  @@map("User")
}

model verificationtoken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token], map: "VerificationToken_identifier_token_key")
  @@map("VerificationToken")
}
